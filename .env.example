DATABASE_URL= "postgresql+asyncpg://abhi:one2three@localhost:5432/mydb"

# ---------------------------------------------------------------------------
# LLM providers (read by LiteLLM). Add the keys for the columns you want to run;
# the others report "failed" in their grid column and the rest still work.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_API_KEY is often already exported in your shell; leave blank to use that.

# Model ids, LiteLLM `provider/model` form. Override to change tiers.
LITELLM_MODEL_CLAUDE=anthropic/claude-sonnet-4-5
LITELLM_MODEL_GEMINI=gemini/gemini-3.5-flash
LITELLM_MODEL_GPT=gpt-4o-mini

# Model used by the single-question /ask route.
LITELLM_MODEL=gpt-4o-mini